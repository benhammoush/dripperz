{
  "name": "dripperz",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "ci:quality": "npm run check",
    "audit:dependencies": "npm audit && npm audit --omit=dev",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "ci:browser": "playwright test && playwright test --config playwright.hero.config.ts",
    "ci:prepare": "node scripts/ci-prepare.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "test": "npm run test:rules && npm run test:unit",
    "test:rules": "node --test tests/tooling/*.test.mjs",
    "test:unit": "vitest run",
    "build": "npm run check:version && npm run typecheck && vite build",
    "test:browser": "npm run build && playwright test",
    "test:e2e": "npm run test:browser",
    "test:hero": "npm run build && playwright test --config playwright.hero.config.ts",
    "check": "npm run lint && npm run format:check && npm run test:rules && npm run test:unit && npm run lint:workflows && npm run audit:dependencies && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
